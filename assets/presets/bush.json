{
  "name": "bush",
  "description": "Stochastic shrub; the seed picks the habit and jitters the geometry.",
  "axiom": "A(1, 0.08)",
  "constants": {
    "a": 28.0,
    "divergence": 137.5
  },
  "rules": [
    "A(l,w) : l > 0.1 -> F(l,w) [ +(a*random(0.7,1.4)) A(l*random(0.65,0.85), w*0.7) ] /(divergence) [ -(a*random(0.7,1.4)) A(l*random(0.65,0.85), w*0.7) ] : 3",
    "A(l,w) : l > 0.1 -> F(l,w) [ &(a*random(1.1,1.7)) A(l*0.7, w*0.7) ] /(divergence) [ ^(a*random(0.8,1.2)) A(l*0.8, w*0.75) ] : 2",
    "A(l,w) : l > 0.1 -> F(l*random(0.9,1.3), w) /(divergence) A(l*0.9, w*0.9) : 1",
    "A(l,w) : l <= 0.1 -> F(l,w)"
  ]
}
